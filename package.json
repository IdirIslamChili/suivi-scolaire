{
  "name": "suivi-scolaire",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node scripts/preload-chunks.mjs",
    "preview": "serve -s www -l tcp://0.0.0.0:8100 --no-clipboard",
    "cap:sync": "npm run build && cap sync"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@capacitor/core": "^7.6.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@ionic/angular": "^8.8.19",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.43",
    "@angular/cli": "^20.3.43",
    "@angular/compiler-cli": "^20.3.0",
    "@capacitor/cli": "^7.6.10",
    "serve": "^14.2.7",
    "typescript": "~5.9.2"
  }
}
